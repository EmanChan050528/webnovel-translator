{
  "manifest_version": 3,
  "name": "Webnovel Translator — Chinese to English, in place",
  "description": "Translates Chinese web novel chapters into English in place, using a local model, with a per-novel glossary you can edit.",
  "version": "0.5.0",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:11434/*",
    "https://www.qidian.com/*",
    "https://www.jjwxc.net/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Webnovel Translator"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.qidian.com/chapter/*",
        "https://www.jjwxc.net/onebook.php*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/site-adapters/*.js"
      ],
      "matches": [
        "https://www.qidian.com/*",
        "https://www.jjwxc.net/*"
      ]
    }
  ]
}
